{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mega-ticketing/shared": ["packages/shared/src/index.ts"],
      "@mega-ticketing/database": ["packages/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
