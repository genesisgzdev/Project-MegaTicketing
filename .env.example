# API Configuration
PORT=3001
NODE_ENV=development
SEAT_LOCK_TTL_MS=30000

# Security
# Mandatory: 32+ characters
JWT_SECRET=your_super_secret_at_least_32_chars_long
# Mandatory: Stripe Secret Key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Persistence
DATABASE_URL=postgresql://postgres:password@localhost:5432/megaticketing?schema=public

# Cache & Locking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Infrastructure
GCP_PROJECT_ID=your-project-id
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Browser/API boundaries
CORS_ORIGINS=http://localhost:5173
# Optional: only trusted operators may toggle defense over WebSocket
WS_ADMIN_TOKEN=

# Database Initial Setup (for Docker)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=megaticketing
