# API Configuration
PORT=3001
NODE_ENV=development

# Security
# Mandatory: 32+ characters
JWT_SECRET=your_super_secret_at_least_32_chars_long
# Mandatory: Stripe Secret Key
STRIPE_SECRET_KEY=sk_test_your_key

# Persistence
DATABASE_URL=postgresql://postgres:password@localhost:5432/megaticketing?schema=public

# Cache & Locking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Infrastructure
GCP_PROJECT_ID=your-project-id
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Database Initial Setup (for Docker)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=megaticketing
