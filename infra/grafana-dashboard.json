  "liveNow": false,
  "panels": [
    {
      "title": "API Throughput (Requests/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(fastify_requests_total[1m])", "legendFormat": "{{method}} {{route}}" }
      ]
    },
    {
      "title": "Payment Success Rate (Stripe Webhooks)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(megaticketing_payments_succeeded_total[5m]) / rate(megaticketing_payments_initiated_total[5m])" }
      ]
    },
    {
      "title": "Redis Lock Latency (P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(megaticketing_redis_lock_duration_seconds_bucket[5m])) by (le))" }
      ]
    }
  ],
  "refresh": "5s",
